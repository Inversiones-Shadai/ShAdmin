APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# HTTP protection; use Redis or a shared database store for multiple servers.
HTTP_RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_STORE=redis
HSTS_MAX_AGE=31536000
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_IP_RATE_LIMIT_PER_MINUTE=20

APP_URL=http://localhost

BOOST_BROWSER_LOGS_WATCHER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=none
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shadaibucket
AWS_USE_PATH_STYLE_ENDPOINT=false

SHADMIN_API_URL=
SHADMIN_APP_VERSION=1.0.0
SHADMIN_API_CONNECT_TIMEOUT=5
SHADMIN_API_TIMEOUT=30
SHADMIN_AUTH_LOGIN_PATH=/auth/session/login
SHADMIN_AUTH_LOGOUT_PATH=/auth/session/logout
SHADMIN_USER_PATH=/config/user
SHADMIN_REPORT_DRAW_PATH=/reportes/sorteos
SHADMIN_REPORT_WORK_LUNCH_PATH=/reportes/worklunch
SHADMIN_PROVIDER_PATH=/farma/proveedores
SHADMIN_CLIENTEPOS_PATH=/pos/clientepos
SHADMIN_LABORATORY_PATH=/farma/laboratorios
SHADMIN_PRODUCT_PATH=/farma/productos/producto
SHADMIN_PRODUCT_CATALOG_PATH=/farma/productos
SHADMIN_PURCHASE_PATH=/farma/compras
SHADMIN_LOT_PATH=/farma/lotes
SHADMIN_PURCHASE_CATALOG_PATH=/farma/compras/catalogos
SHADMIN_DEVICE_HEADER_SECRET=
SHADMIN_DEVICE_NAME=SHADMIN-WEB
# SHADMIN_DEVICE_IP= - omitir para usar la IP de la petición web

VITE_APP_NAME="${APP_NAME}"
AWS_ENDPOINT=https://cellar-c2.services.clever-cloud.com
IMAGE_STORAGE_ENABLED=true
IMAGE_STORAGE_DISK=s3
IMAGE_STORAGE_PREFIX=shadmin/images
IMAGE_STORAGE_URL_MINUTES=720
IMAGE_LOGO_NAVIGATION_UUID=
IMAGE_LOGO_TICKET_UUID=
IMAGE_LOGO_TRANSFER_UUID=
AWS_CA_BUNDLE=
